# PostgreSQL persistence
DATABASE_URL=postgresql://talentlens_app:URL_ENCODED_PASSWORD@localhost:5432/talentlens_demo

# HackerRank for Work - keep the actual token only in your private .env file.
HACKERRANK_API_KEY=
HACKERRANK_TIMEZONE=Asia/Kolkata
HACKERRANK_WEBHOOK_SECRET=

# Chakra interviewer share link (copy from Chakra > My Interviewers > Invite candidates).
# The local UI creates an email draft; a recruiter must send it and confirm the invite.
CHAKRA_INTERVIEW_NAME=TalentLens Data Engineer Interview (3-6 YOE)
CHAKRA_INTERVIEWER_ID=
CHAKRA_INTERVIEW_URL=

# OPTIONAL: real Chakra candidate/report API sync. Obtain these exact values from your
# Chakra workspace/HackerRank Support. Do not guess endpoint paths or authentication.
# URL is a full HTTPS endpoint/template issued by HackerRank; supported placeholders are
# {interviewerId} and {email}. Example intentionally omitted because public docs do not
# expose the specific endpoint contract. Use an official hackerrank.com host.
CHAKRA_API_RESULTS_URL_TEMPLATE=
CHAKRA_API_TOKEN=
CHAKRA_API_AUTH_HEADER=
CHAKRA_API_AUTH_PREFIX=
