# ==============================================================================
# TalentLens Environment Configuration Template (.env.example)
#
# NOTICE: This file is a safe reference template.
# DO NOT paste live secrets or production credentials into this file or git.
# Copy this file to `.env` in your project root and populate with your own values:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# PORT [Optional]
# The HTTP port the Express server listens on.
# Default fallback: 3000
PORT=3000

# NODE_ENV [Optional]
# Set to 'development' for local work with Vite middleware, or 'production' for Cloud Run.
# Values: development | production | test
# Default fallback: development
NODE_ENV=development

# FRONTEND_URL [Optional]
# The primary public URL of the frontend application.
# Used for metadata and absolute redirection.
FRONTEND_URL=http://localhost:3000

# CORS_ALLOWED_ORIGINS [Optional]
# Comma-separated list of allowed cross-origin origins in production.
# Leave blank or omit in development when frontend is served from the same Express origin.
# Example: https://talentlens.your-company.run.app,https://talentlens.corp.internal
CORS_ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Neon PostgreSQL)
# ------------------------------------------------------------------------------
# DATABASE_URL [Mandatory for standard app runtime]
# Connection string for Neon Serverless PostgreSQL with SSL enabled.
# How to obtain:
#   1. Sign up at https://neon.tech and create a PostgreSQL project.
#   2. Copy the Connection Details string (pooled endpoint recommended).
# Placeholder format:
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

# ADMIN_DATABASE_URL [Optional / Stage A DB Admin only]
# Connection string with database owner privileges (e.g., neondb_owner)
# used exclusively by `scripts/stage_a_admin_init.ts` for initial schema setup.
# Never required for regular application boot or Cloud Run runtime.
ADMIN_DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

# DB_POOL_MAX [Optional]
# Maximum number of concurrent connections in the pg connection pool.
# Default fallback: 10
DB_POOL_MAX=10

# DB_AUTO_DDL [Optional]
# If set to 'true', attempts to run idempotent CREATE TABLE DDL on server boot.
# Default fallback: false (recommended: manage schemas via scripts/stage_a_admin_init.ts)
DB_AUTO_DDL=false

# DB_AUTO_SEED [Optional]
# If set to 'true', seeds default employee and mentor records if the database is empty.
# Default fallback: false
DB_AUTO_SEED=false

# ENABLE_DEMO_SEED [Optional]
# If set to 'true', seeds a mock candidate record for testing assessment flows.
# Default fallback: false
ENABLE_DEMO_SEED=false

# ------------------------------------------------------------------------------
# 3. APPLICATION RBAC & TESTING MODE
# ------------------------------------------------------------------------------
# TEMPORARY_ADMIN_TESTING_MODE [Optional]
# When 'true', grants all successfully authenticated Google Workspace accounts
# temporary Admin-level testing permissions to evaluate all workflows.
# Values: true | false
# Default fallback: true (set to 'false' to enforce strict Role-Based Access Control)
TEMPORARY_ADMIN_TESTING_MODE=true

# ------------------------------------------------------------------------------
# 4. HACKERRANK FOR WORK INTEGRATION
# ------------------------------------------------------------------------------
# HACKERRANK_API_KEY [Optional — Required for HackerRank invitations & sync]
# Bearer API token obtained from HackerRank for Work.
# How to obtain:
#   1. Sign in to HackerRank for Work (https://www.hackerrank.com/work).
#   2. Navigate to Company Settings > Integrations / API.
#   3. Generate a Bearer API token with test invite and candidate evaluation permissions.
# Default fallback: If omitted, assessment invitations and live sync return an informative
# error prompting configuration; UI remains interactive.
HACKERRANK_API_KEY=YOUR_HACKERRANK_API_KEY

# HACKERRANK_TIMEZONE [Optional]
# Timezone passed in the HackerRank invitation payload.
# Default fallback: Asia/Kolkata
HACKERRANK_TIMEZONE=Asia/Kolkata

# HACKERRANK_WEBHOOK_SECRET [Optional]
# Shared secret for authenticating incoming HackerRank assessment webhooks at /api/webhooks/hackerrank.
# Default fallback: If omitted, webhook endpoint rejects requests with HTTP 503; manual sync works.
HACKERRANK_WEBHOOK_SECRET=YOUR_HACKERRANK_WEBHOOK_SECRET

# ------------------------------------------------------------------------------
# 5. CHAKRA AI TECHNICAL INTERVIEW INTEGRATION
# ------------------------------------------------------------------------------
# CHAKRA_INTERVIEW_URL [Optional — Required to launch Chakra AI interviews]
# Public HTTPS link to the Chakra AI technical assessment / interview room.
# Example: https://app.chakra.ai/interview/YOUR_INTERVIEW_ID
CHAKRA_INTERVIEW_URL=https://app.chakra.ai/interview/YOUR_INTERVIEW_ID

# CHAKRA_INTERVIEW_NAME [Optional]
# Label shown on candidate assessment cards and dispatch logs.
# Default fallback: Chakra Data Engineer Interview
CHAKRA_INTERVIEW_NAME=Chakra Data Engineer Interview

# CHAKRA_INTERVIEWER_ID [Optional]
# Identifier of the AI interviewer persona within the Chakra workspace.
CHAKRA_INTERVIEWER_ID=YOUR_CHAKRA_INTERVIEWER_ID

# CHAKRA_API_RESULTS_URL_TEMPLATE [Optional — Required for automated Chakra score sync]
# REST URL template used by the server to query candidate results from Chakra.
# Supported variable substitution: {email}
# Example: https://www.hackerrank.com/x/api/v3/chakra/results?email={email}
CHAKRA_API_RESULTS_URL_TEMPLATE=https://www.hackerrank.com/x/api/v3/chakra/results?email={email}

# CHAKRA_API_TOKEN [Optional — Required for automated Chakra score sync]
# Authentication token for the Chakra evaluation API.
# Note: The server only dispatches requests to official HTTPS endpoints.
CHAKRA_API_TOKEN=YOUR_CHAKRA_API_TOKEN

# CHAKRA_API_AUTH_HEADER [Optional]
# Header name used for passing the Chakra API token.
# Default fallback: Authorization
CHAKRA_API_AUTH_HEADER=Authorization

# CHAKRA_API_AUTH_PREFIX [Optional]
# Header prefix (e.g. 'Bearer ') prefixed to the token.
# Default fallback: Bearer 
CHAKRA_API_AUTH_PREFIX=Bearer 